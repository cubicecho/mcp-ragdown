<section class="hero">
  <div class="wrap">
    <p class="eyebrow">MCP server over Markdown</p>
    <h1>{{ site.tagline }}</h1>
    <p class="lede">
      Point mcp-ragdown at a folder of Markdown files. It splits every file into heading-scoped sections, embeds
      them into a local LanceDB index, keeps that index in sync as the files change, and serves hybrid search over
      <a href="https://modelcontextprotocol.io">MCP</a>. A prompt hook can call <code>ragdown_context</code> to add
      the related notes to every turn.
    </p>
    <div class="cta-row">
      <a class="btn btn-primary" href="{{ '/get-started/' | url }}">Get started →</a>
      <a class="btn btn-ghost" href="#quickstart">Quickstart</a>
      <a class="btn btn-ghost" href="{{ site.repo }}">View on GitHub ↗</a>
    </div>

    <div class="endpoint-card" aria-hidden="false">
      <div class="endpoint-row">
        <span class="method method-agg">ALL</span>
        <code>http://host:3300/mcp</code>
        <span class="endpoint-note">the whole folder</span>
      </div>
      <div class="endpoint-row">
        <span class="method">ALL</span>
        <code>http://host:3300/mcp/&lt;folder&gt;</code>
        <span class="endpoint-note">one folder, as its own root</span>
      </div>
    </div>
  </div>
</section>

