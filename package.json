{
  "name": "mcp-ragdown",
  "version": "5.7.0",
  "private": true,
  "description": "RAG over a folder of Markdown files, exposed over MCP, with a context tool for hooks that inject related notes into every prompt",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "bin": {
    "ragdown": "src/cli.ts"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/cli.ts stdio",
    "dev:web": "vite --config web/vite.config.ts",
    "start": "node --env-file-if-exists=.env src/cli.ts stdio",
    "build": "vite build --config web/vite.config.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@lancedb/lancedb": "^0.38.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "apache-arrow": "^18.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource-variable/geist": "^5.3.0",
    "@lezer/highlight": "^1.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.36",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "lucide-react": "^1.45.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
