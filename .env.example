# The folder of Markdown files to index (required). Subfolders are included.
RAGDOWN_DOCS_DIR=
# Where the LanceDB index lives. Default: ~/.cache/ragdown/<hash of the docs dir>
# RAGDOWN_DATA_DIR=
# bge-small (default, local ONNX), hash (tests only), or openai:<model> for any OpenAI-compatible endpoint
# RAGDOWN_EMBEDDER=bge-small
# RAGDOWN_EMBEDDING_URL=https://api.openai.com/v1
# RAGDOWN_EMBEDDING_API_KEY=
# RAGDOWN_READ_ONLY=false
# RAGDOWN_WATCH=true
# ONNX Runtime threads for bge-small. Default (0): half the logical cores, which beat all of them in testing
# RAGDOWN_THREADS=0
# Where ragdown_remember writes, relative to the docs dir
# RAGDOWN_NOTES_DIR=notes
# Characters per hit in ragdown_recall text output before it is clipped (0 = never)
# RAGDOWN_TEXT_LIMIT=2000
# UserPromptSubmit hook: chunks injected, minimum cosine similarity, total size, socket timeout
# RAGDOWN_HOOK_TOP_K=4
# RAGDOWN_HOOK_MIN_SCORE=0.7
# RAGDOWN_HOOK_MAX_CHARS=6000
# RAGDOWN_HOOK_TIMEOUT_MS=5000

# `serve` (HTTP, what the Docker image runs)
# PORT=3000
# Bearer token for /mcp and /api/context: openssl rand -hex 32. Required unless SECURE_LOCAL_NET=true
# RAGDOWN_TOKEN=
# SECURE_LOCAL_NET=false
# Hook only: ask a `serve` instance over HTTP (sending RAGDOWN_TOKEN) instead of the local socket
# RAGDOWN_URL=http://localhost:3300
