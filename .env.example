# The folder of Markdown files to index (required). Subfolders are included.
RAGDOWN_DOCS_DIR=
# Where the LanceDB index lives. Default: ~/.cache/ragdown/<hash of the docs dir>
# RAGDOWN_DATA_DIR=
# A local ONNX model — granite-small (default), bge-small (smaller, a little less accurate),
# embeddinggemma (most accurate, 25x the query latency) — or hash (tests only), or openai:<model>
# for any OpenAI-compatible endpoint. Changing this rebuilds the index, moves MIN_SCORE below
# (see the README's embedder table), and only granite-small is baked into the Docker image.
# RAGDOWN_EMBEDDER=granite-small
# RAGDOWN_EMBEDDING_URL=https://api.openai.com/v1
# RAGDOWN_EMBEDDING_API_KEY=
# RAGDOWN_READ_ONLY=false
# RAGDOWN_WATCH=true
# ONNX Runtime threads for the local model. Default (0): half the logical cores, which beat all of them in testing
# RAGDOWN_THREADS=0
# Where ragdown_remember writes, relative to the docs dir
# RAGDOWN_NOTES_DIR=notes
# Characters per hit in ragdown_recall text output before it is clipped (0 = never)
# RAGDOWN_TEXT_LIMIT=2000
# ragdown_context defaults (what a hook injects): chunks, minimum cosine similarity, total size
# RAGDOWN_HOOK_TOP_K=4
# RAGDOWN_HOOK_MIN_SCORE=0.8
# RAGDOWN_HOOK_MAX_CHARS=6000

# `serve` (HTTP, what the Docker image runs)
# PORT=3000
# Bearer token for /mcp and the web UI's /api routes: openssl rand -hex 32. Required unless SECURE_LOCAL_NET=true
# RAGDOWN_TOKEN=
# SECURE_LOCAL_NET=false
