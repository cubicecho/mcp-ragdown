<section class="hero">
  <div class="wrap">
    <p class="eyebrow">MCP server over Markdown</p>
    <h1>{{ site.tagline }}</h1>
    <p class="lede">
      Point mcp-ragdown at a directory of Markdown folders. It splits every file into heading-scoped sections,
      embeds them into a local LanceDB index, keeps that index in sync as the files change, and serves hybrid search
      over <a href="https://modelcontextprotocol.io">MCP</a> — one server per folder, for the folders you turn on.
      Each folder opens as an Obsidian vault, and a prompt hook can call <code>ragdown_context</code> to add the
      related notes to every turn.
    </p>
    <div class="cta-row">
      <a class="btn btn-primary" href="{{ '/get-started/' | url }}">Get started →</a>
      <a class="btn btn-ghost" href="#quickstart">Quickstart</a>
      <a class="btn btn-ghost" href="{{ site.repo }}">View on GitHub ↗</a>
    </div>

    <div class="endpoint-card" aria-hidden="false">
      <div class="endpoint-row">
        <span class="method method-agg">MCP</span>
        <code>http://host:3300/mcp/&lt;folder&gt;</code>
        <span class="endpoint-note">one folder, once MCP is on</span>
      </div>
      <div class="endpoint-row">
        <span class="method">MCP</span>
        <code>http://host:3300/mcp/&lt;folder&gt;/&lt;sub&gt;</code>
        <span class="endpoint-note">a subfolder of it</span>
      </div>
      <div class="endpoint-row">
        <span class="method">UI</span>
        <code>http://host:3300/</code>
        <span class="endpoint-note">every folder, human-only ones too</span>
      </div>
    </div>
  </div>
</section>

